			<key>CFBundleTypeExtensions</key>
			<array><string>txt</string><string>md</string><string>text</string></array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key><string>public.plain-text</string>
			<key>UTTypeConformsTo</key><array><string>public.text</string></array>
			<key>UTTypeTagSpecification</key>
			<dict><key>public.filename-extension</key><array><string>txt</string><string>text</string></array></dict>
		</dict>
	</array>
</dict>
</plist>
